{
  "$schema": "https://schema.management.azure.com/schemas/2018-05-01/subscriptionDeploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "searchLocation": { "value": "${AZURE_SEARCH_LOCATION=francecentral}" },
    "principalId": { "value": "${AZURE_PRINCIPAL_ID}" },
    "tenantId": { "value": "${TENANT_ID}" },
    "dealerExists": { "value": "${SERVICE_DEALER_RESOURCE_EXISTS=false}" },
    "dealerClientId": { "value": "${DEALER_CLIENT_ID}" },
    "apiExists": { "value": "${SERVICE_API_RESOURCE_EXISTS=false}" },
    "apiClientId": { "value": "${API_CLIENT_ID}" }
  }
}
